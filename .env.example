# Copy this file to .env and fill in real values before running docker-compose
# Never commit .env to version control

# Required: 256-bit (32-byte) secret shared across all backend services
JWT_SECRET=change-me-to-a-256-bit-secret-at-least-32-chars-long!!

# Access token lifetime in milliseconds (default: 86400000 = 24 hours)
JWT_ACCESS_EXPIRY=86400000

# PostgreSQL credentials (must match POSTGRES_USER/PASSWORD in postgres service)
DATABASE_USERNAME=DATABASE_USERNAME
DATABASE_PASSWORD=DATABASE_PASSWORD

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mock payment mode — confirms orders immediately without a payment provider
# Set to false in production to require real payment integration
MOCK_PAYMENT_CHECKOUT=true

# Set to true when running behind HTTPS (required for Secure cookie flag in production)
COOKIE_SECURE=false
